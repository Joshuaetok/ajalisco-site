2, U+2215, U+FEFF, U+FFFD; }\n\n/* Decorative rising bubbles (Banner, CTA) */\n.ajx-bls:not(#ajx-n) .ajx-bubbles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }\n.ajx-bls:not(#ajx-n) .ajx-bubbles i { position: absolute; bottom: -70px; width: var(--s); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 32% 28%, rgba(255,255,255,.95) 0 7%, rgba(255,255,255,.2) 22%, rgba(255,255,255,.05) 62%); box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); animation: ajxBlgRise var(--d) linear infinite; animation-delay: var(--dl); }\n.ajx-bls:not(#ajx-n) .ajx-bubbles i:nth-child(1) { left: 5%; --s: 30px; --d: 17s; --dl: -3s; }\n.ajx-bls:not(#ajx-n) .ajx-bubbles i:nth-child(2) { left: 24%; --s: 46px; --d: 23s; --dl: -14s; }\n.ajx-bls:not(#ajx-n) .ajx-bubbles i:nth-child(3) { left: 49%; --s: 60px; --d: 27s; --dl: -18s; }\n.ajx-bls:not(#ajx-n) .ajx-bubbles i:nth-child(4) { left: 67%; --s: 34px; --d: 20s; --dl: -11s; }\n.ajx-bls:not(#ajx-n) .ajx-bubbles i:nth-child(5) { left: 87%; --s: 50px; --d: 25s; --dl: -9s; }\n.ajx-bls:not(#ajx-n) .ajx-bubbles i:nth-child(6) { left: 95%; --s: 14px; --d: 13s; --dl: -5s; }\n@keyframes ajxBlgRise { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: 1; } 100% { transform: translate(24px,-120vh); opacity: .2; } }\n\n/* Second gradient layer under the Banner/CTA native background */\n.ajx-bls:not(#ajx-n) .ajx-glow-banner { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(700px 300px at 85% 0%, rgba(90,160,255,.5), transparent 60%); }\n.ajx-bls:not(#ajx-n) .ajx-glow-cta { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(700px 400px at 100% 0%, rgba(90,160,255,.5), transparent 60%); }\n\n@media (prefers-reduced-motion: reduce) {\n  .ajx-bls:not(#ajx-n) .ajx-bubbles i { animation: none !important; }\n}\n\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content { max-width: 740px; margin-inline: auto; font-size: 17px; line-height: 1.8; color: #54595F; font-family: 'Nunito', sans-serif; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content > :first-child { margin-top: 0; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content p { margin: 0 0 20px; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content h2 { font: 700 28px/1.3 'Outfit', sans-serif; color: #0256DB; margin: 40px 0 16px; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content h3 { font: 700 22px/1.3 'Outfit', sans-serif; color: #0256DB; margin: 34px 0 14px; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content h4 { font: 600 18px 'Outfit', sans-serif; color: #16204A; margin: 26px 0 10px; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content strong { color: #16204A; font-weight: 700; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content ul, .ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content ol { margin: 0 0 20px; padding-left: 1.4em; display: grid; gap: 8px; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content li { padding-left: 4px; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content blockquote { margin: 28px 0; padding: 20px 24px; border-left: 4px solid #28A745; background: #F5F5F5; border-radius: 0 14px 14px 0; font-style: italic; color: #16204A; }\n.ajx-bls:not(#ajx-n) .elementor-widget-theme-post-content blockquote p { margin: 0; }\n\n/* Astra wraps this single-post template in its own .ast-container, and\n   specifically uses a 750px \"narrow container\" width for single posts\n   (meant for plain blog-text reading, not an edge-to-edge hero design) --\n   confirmed on the live site via the ast-narrow-container body class and\n   the --ast-narrow-container-width:750px custom property. Elementor's\n   page-level \"Header Footer\" template bypasses this wrapper on real\n   Pages (home/shop/about/etc. all use it) but Theme Builder archive/\n   single templates have no equivalent bypass, so it has to be\n   overridden here instead. */\n#content.site-content .ast-container { max-width: none !important; padding-inline: 0 !important; }\n</style>"
