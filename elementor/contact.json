-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n@font-face { font-family: 'Nunito'; font-style: normal; font-weight: 700; font-display: swap; src: url(https://joshuaetok.github.io/ajalisco-site/assets/fonts/nunito-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n@font-face { font-family: 'Outfit'; font-style: normal; font-weight: 600; font-display: swap; src: url(https://joshuaetok.github.io/ajalisco-site/assets/fonts/outfit-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n@font-face { font-family: 'Outfit'; font-style: normal; font-weight: 600; font-display: swap; src: url(https://joshuaetok.github.io/ajalisco-site/assets/fonts/outfit-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n@font-face { font-family: 'Outfit'; font-style: normal; font-weight: 700; font-display: swap; src: url(https://joshuaetok.github.io/ajalisco-site/assets/fonts/outfit-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n@font-face { font-family: 'Outfit'; font-style: normal; font-weight: 700; font-display: swap; src: url(https://joshuaetok.github.io/ajalisco-site/assets/fonts/outfit-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n\n/* Decorative rising bubbles (Banner) — no native Elementor equivalent for randomized per-bubble rise timing. Touches position/background/animation only, never typography. */\n.ajx-cnt:not(#ajx-n) .ajx-bubbles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }\n.ajx-cnt:not(#ajx-n) .ajx-bubbles i { position: absolute; bottom: -70px; width: var(--s); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 32% 28%, rgba(255,255,255,.95) 0 7%, rgba(255,255,255,.2) 22%, rgba(255,255,255,.05) 62%); box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); animation: ajxCntRise var(--d) linear infinite; animation-delay: var(--dl); }\n.ajx-cnt:not(#ajx-n) .ajx-bubbles i:nth-child(1) { left: 5%; --s: 30px; --d: 17s; --dl: -3s; }\n.ajx-cnt:not(#ajx-n) .ajx-bubbles i:nth-child(2) { left: 24%; --s: 46px; --d: 23s; --dl: -14s; }\n.ajx-cnt:not(#ajx-n) .ajx-bubbles i:nth-child(3) { left: 49%; --s: 60px; --d: 27s; --dl: -18s; }\n.ajx-cnt:not(#ajx-n) .ajx-bubbles i:nth-child(4) { left: 67%; --s: 34px; --d: 20s; --dl: -11s; }\n.ajx-cnt:not(#ajx-n) .ajx-bubbles i:nth-child(5) { left: 87%; --s: 50px; --d: 25s; --dl: -9s; }\n@keyframes ajxCntRise { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: 1; } 100% { transform: translate(24px,-120vh); opacity: .2; } }\n\n/* Second gradient layer under the Banner's native gradient background — Elementor's own background control only supports one gradient layer. Position/background only, never typography. */\n.ajx-cnt:not(#ajx-n) .ajx-glow-banner { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(700px 300px at 85% 0%, rgba(90,160,255,.5), transparent 60%); }\n\n@media (prefers-reduced-motion: reduce) {\n  .ajx-cnt:not(#ajx-n) .ajx-bubbles i { animation: none !important; }\n}\n\n/* WhatsApp submit hook: the live site's real contact-form behaviour (confirmed in app.js) is opening WhatsApp with a pre-filled message, not emailing anyone. Elementor's native Form widget has no built-in action that builds a wa.me link from field values, so this one piece of behaviour is a deliberate, isolated JS exception. It only reads field values and sets no styling. */\n</style>\n<script>\n(function () {\n  function openWhatsApp(text) {\n    window.open('https://wa.me/2347078581881?text=' + encodeURIComponent(text), '_blank', 'noopener');\n  }\n  function fieldValue(form, cls) {\n    var el = form.querySelector('.' + cls + ' input, .' + cls + ' textarea, input.' + cls + ', textarea.' + cls);\n    return el ? (el.value || '').trim() : '';\n  }\n  document.addEventListener('submit_success', function (e) {\n    var form = e.target.closest ? e.target.closest('.ajx-contact-form') : null;\n    if (!form) return;\n    var name = fieldValue(form, 'ajx-f-name'), email = fieldValue(form, 'ajx-f-email'), phone = fieldValue(form, 'ajx-f-phone'),\n        business = fieldValue(form, 'ajx-f-business'), inquiry = fieldValue(form, 'ajx-f-inquiry'), message = fieldValue(form, 'ajx-f-message');\n    openWhatsApp([\n      'Hello Ajalisco \\ud83d\\udc4b New message from the website:', '',\n      'Name: ' + name, 'Email: ' + email, 'Phone: ' + phone,\n      'Business: ' + (business || '-'), 'Enquiry: ' + (inquiry || '-'), 'Message: ' + message\n    ].join('\\n'));\n  });\n})();\n</script>"
          },
